# ==============================================================================
# RecoverIQ - AI Agent Environment Configuration Example
# ==============================================================================
# Configure the LLM provider for the RecoverIQ Autonomous Recovery Agent.
# Supported providers: gemini, openai, groq, openrouter, anthropic, azure, ollama
# ==============================================================================

# LLM Provider Type (e.g. gemini, openai, groq, openrouter, anthropic, ollama)
AI_PROVIDER=gemini

# Model Identifier (e.g. gemini-1.5-pro, gpt-4o, llama-3.3-70b-versatile, claude-3-5-sonnet-20241022)
AI_MODEL=gemini-1.5-pro

# API Key (Not required for local Ollama)
AI_API_KEY=your_api_key_here

# Base URL (Optional - custom endpoint or proxy)
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
